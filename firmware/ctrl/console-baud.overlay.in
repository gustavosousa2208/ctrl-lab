/*
 * Generated by CMake from CTRL_CONSOLE_BAUD - do not edit.
 *
 * nucleo_f767zi.dts fixes usart3 at 115200. The console carries the whole trace
 * (~31 KB for a 501-step run), so the console baud is the trace transport's
 * bandwidth, and it is worth being able to sweep rather than assume.
 */
&usart3 {
	current-speed = <@CTRL_CONSOLE_BAUD@>;
};
