/* The link probe's own overlay. The link itself is in the shared .dtsi, which
 * firmware/ctrl includes too; the DTCM selection stays here because it is a
 * per-application choice.
 */

#include "mini_stm32h743-link.dtsi"

/ {
	chosen {
		/* Same reason as every other application here: the board .dts
		 * declares dtcm but never selects it, so without this the
		 * __dtcm_* sections do not exist. See firmware/BRINGUP.md.
		 */
		zephyr,dtcm = &dtcm;
	};
};
