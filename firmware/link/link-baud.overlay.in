/*
 * Generated by CMake from LINK_BAUD - do not edit.
 *
 * Both ends must agree. 1/2/3/4/6 Mbaud are exact on both boards
 * (F767 usart6 on APB2 at 108 MHz, H743 usart1 on APB2 at 120 MHz), so the
 * baud error is zero rather than merely small.
 */
&@LINK_UART@ {
	current-speed = <@LINK_BAUD@>;
};
